PORT=3000
ZOZ_NAME=ZOZ AI
WHATSAPP_API_VERSION=v23.0

# Optional durable state (KV-compatible REST)
KV_REST_API_URL=
KV_REST_API_TOKEN=
ZOZ_STATE_KEY=zoz-ai:state

# Autonomous Vercel Cron authentication — set this only as a hosting Environment Variable.
CRON_SECRET=

# External connectors — secrets belong only in hosting Environment Variables.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
YOUTUBE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_STORE_DOMAIN=

# Optional fallback names when managed KV variables are not provisioned in Production
ZOZ_KV_REST_API_URL=
ZOZ_KV_REST_API_TOKEN=
